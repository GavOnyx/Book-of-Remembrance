<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Contacts permission arrives with the Contacts milestone; the app
         must already work fully when it is denied. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Device-to-device share (M15) uses plain TCP sockets on the local
         Wi-Fi network. INTERNET is a normal install-time permission: it is
         granted automatically with no runtime prompt. No other permission
         was added. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: resolveActivity() on these implicit
         intents returns null unless declared here. (Starting the activity
         itself works without this; only the *query* is filtered.) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalOnyx">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- v0.17.1: adjustResize (no panning). The app is edge-to-edge
                 and handles the keyboard via WindowInsets itself; the old
                 default (pan) double-compensated with the editor's
                 imePadding, producing the overshoot + phantom bar. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
